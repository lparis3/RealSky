    year: 2019
    journal: "Publications of the Astronomical Society of Japan"
    volume: 71
    issue: 6
    start: 114
    doi: 10.1093/pasj/psz103

  # Optional citations listed by the GalaxiesML authors: spectroscopic
  # redshift surveys used to build the ground-truth redshifts.

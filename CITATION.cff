      name: Zenodo
    version: v6
    date-released: 2024-05-06
    doi: 10.5281/zenodo.11117528
    url: "https://zenodo.org/records/11117528"
    license: CC-BY-4.0

  - type: article
    title: "GalaxiesML: a dataset of galaxy images, photometry, redshifts, and structural parameters for machine learning"

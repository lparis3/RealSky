    url: "https://arxiv.org/abs/2410.00271"

  # Requested by the GalaxiesML authors: the underlying HSC imaging survey.
  - type: article
    title: "Second data release of the Hyper Suprime-Cam Subaru Strategic Program"
    authors:
      - family-names: Aihara
        given-names: Hiroaki

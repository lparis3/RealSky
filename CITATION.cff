cff-version: 1.2.0
message: >-
  If you use this software or the data it produces, please cite it using the
  metadata below. Please also cite the input datasets and papers listed under
  "references", as requested by their authors.
title: "RealSky"
type: software
authors:
  - family-names: Paris
    given-names: Lucca
    # orcid: "https://orcid.org/0000-0000-0000-0000"
repository-code: "https://github.com/lparis3/deeplens_update"
# license: MIT
# version: 1.0.0
# date-released: 2026-10-20

references:
  # ---------------------------------------------------------------------------
  # 1. Observational galaxy images: GalaxiesML
  # ---------------------------------------------------------------------------
  - type: data
    title: "Data for GalaxiesML: an imaging and photometric dataset of galaxies for machine learning"
    authors:
      - family-names: Do
        given-names: Tuan
        orcid: "https://orcid.org/0000-0001-9554-6062"
      - family-names: Jones
        given-names: Evan
        orcid: "https://orcid.org/0000-0001-7725-2546"
